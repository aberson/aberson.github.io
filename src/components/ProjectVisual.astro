---
interface Props {
  slug: string;
  name: string;
}
const { slug, name } = Astro.props;
const visuals: Record<
  string,
  {
    file: string;
    caption: string;
    alt: string;
    width: number;
    height: number;
    kind?: string;
    disclosure?: string;
  }
> = {
  Alpha4Gate: {
    file: "alpha4gate-gameplay.jpg",
    caption: "Gameplay and decision graph",
    alt: "StarCraft II gameplay on the left and a colorful branching decision graph on the right.",
    width: 1080,
    height: 600,
  },
  pta_finance: {
    file: "pta-finance-snapshot.png",
    caption: "A financial snapshot for a treasurer. Fictional example data.",
    alt: "Example treasurer report showing cash balances, fundraising, spending and budget progress.",
    width: 1600,
    height: 900,
  },
  void_furnace: {
    file: "void-furnace-state.png",
    caption:
      "Captured factory state: issues move through implementation, review and merge.",
    alt: "Factory interface showing issue states and transitions, including review, fixes and merge.",
    width: 707,
    height: 889,
    kind: "factory",
  },
  "dev-observatory": {
    file: "observatory-timeline.png",
    caption: "Historical execution timeline",
    disclosure:
      "Historical capture. Full dashboard also includes planning views.",
    alt: "Observed timeline section of a saved workspace dashboard, with horizontal bars for recorded processes.",
    width: 1440,
    height: 3819,
    kind: "timeline",
  },
};
const galleries: Record<string, (typeof visuals)[string][]> = {
  pta_finance: [
    {
      ...visuals.pta_finance,
      caption: "1. Current snapshot",
      disclosure: "Fictional example data",
    },
    {
      file: "pta-fundraising-summary.png",
      caption: "2. Fundraising summary",
      disclosure: "Fictional example data",
      alt: "Fundraising report with progress toward the goal and income by event.",
      width: 816,
      height: 1056,
      kind: "report",
    },
    {
      file: "pta-reimbursement-private.png",
      caption: "3. Private reimbursement detail",
      disclosure: "Anonymized demonstration",
      alt: "Detailed reimbursement review queue with item decisions, payment amounts and outstanding actions.",
      width: 1400,
      height: 1000,
      kind: "report",
    },
    {
      file: "pta-reimbursement-public.png",
      caption: "4. Public reimbursement summary",
      disclosure: "Anonymized demonstration",
      alt: "One-page reimbursement summary with payment totals, status chart and board discussion items.",
      width: 816,
      height: 1056,
      kind: "report",
    },
  ],
  "skill-mesh": [
    {
      file: "skill-mesh-core-pipeline-light.svg",
      caption: "Build pipeline",
      alt: "Skill-mesh build pipeline, from planning and review through building, acceptance and repository updates.",
      width: 1000,
      height: 290,
      kind: "diagram",
    },
    {
      file: "skill-mesh-review-gate-light.svg",
      caption: "Build-step pipeline",
      alt: "Code-lane build step: isolated developer, configured checks, five reviewers, strong orchestrator judge, uncommitted landing, verification and finalization; repair and blocking paths remain explicit.",
      width: 1080,
      height: 350,
      kind: "diagram",
    },
  ],
  void_furnace: [
    {
      ...visuals.void_furnace,
      caption: "Factory state machine",
      kind: "factory",
    },
  ],
};
const gallery = galleries[slug] ?? (visuals[slug] ? [visuals[slug]] : []);
---

<div
  class:list={[
    "project-gallery",
    {
      "project-gallery--grid": gallery.length > 1 && slug !== "skill-mesh",
      "project-gallery--stack": slug === "skill-mesh",
    },
  ]}
>
  {
    gallery.map((visual) => {
      const src = `${import.meta.env.BASE_URL}projects/${visual.file}`;
      return (
        <figure class="project-visual">
          <a
            class:list={["project-visual__preview", visual.kind]}
            href={src}
            data-image-viewer
            aria-label={`Expand ${name}: ${visual.caption}`}
          >
            <img
              src={src}
              alt={visual.alt}
              width={visual.width}
              height={visual.height}
              loading="lazy"
              decoding="async"
            />
          </a>
          <figcaption>
            <div class="caption-row">
              <strong>{visual.caption}</strong>
              <a
                href={src}
                data-image-viewer
                aria-label={`Expand ${name}: ${visual.caption}`}
              >
                Expand image
              </a>
            </div>
            {visual.disclosure && <small>{visual.disclosure}</small>}
            {visual.kind === "diagram" && (
              <small class="diagram-hint">
                Scroll across to follow the pipeline, or expand.
              </small>
            )}
          </figcaption>
          <dialog aria-label={`${name}: ${visual.caption}`}>
            <div class="viewer-toolbar">
              <a href={src} target="_blank" rel="noopener noreferrer">
                Open original
              </a>
              <button type="button" data-close-viewer>
                Close
              </button>
            </div>
            <p class="viewer-caption">
              {visual.caption}
              {visual.disclosure && ` — ${visual.disclosure}`}
            </p>
            <div class="viewer-image">
              <img
                src={src}
                alt={visual.alt}
                width={visual.width}
                height={visual.height}
                loading="lazy"
              />
            </div>
          </dialog>
        </figure>
      );
    })
  }
</div>

<script>
  document
    .querySelectorAll<HTMLAnchorElement>("[data-image-viewer]")
    .forEach((link) => {
      const dialog = link.closest("figure")?.querySelector("dialog");
      if (!dialog) return;
      link.addEventListener("click", (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
          return;
        event.preventDefault();
        dialog.showModal();
      });
      dialog
        .querySelector("[data-close-viewer]")
        ?.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
</script>

<style>
  figure {
    margin: 0;
    min-width: 0;
  }
  .project-visual__preview {
    display: block;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-semantic-border);
    border-radius: var(--radius-lg);
    background: #101318;
    aspect-ratio: 16 / 9;
  }
  .project-visual__preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .project-visual__preview.factory {
    aspect-ratio: 707 / 485;
  }
  .project-visual__preview.factory img {
    height: auto;
  }
  .project-visual__preview.timeline {
    aspect-ratio: 16 / 6.2;
  }
  .project-visual__preview.timeline img {
    height: auto;
    transform: translateY(-63%);
  }
  figcaption {
    margin-top: var(--space-3);
    color: var(--color-semantic-text-muted);
    font-size: var(--type-scale-step--1);
    line-height: var(--type-line-height-base);
  }
  dialog {
    padding: var(--space-4);
    width: min(94vw, 1440px);
    max-width: 96vw;
    max-height: 92vh;
    border: 1px solid var(--color-semantic-border);
    border-radius: var(--radius-lg);
    background: var(--color-semantic-surface);
    color: var(--color-semantic-text);
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 75%);
  }
  .viewer-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }
  .viewer-toolbar a,
  figcaption a {
    color: var(--color-semantic-accent);
  }
  .viewer-toolbar button {
    font: inherit;
    padding: 8px 16px;
    cursor: pointer;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-semantic-border);
    background: var(--color-semantic-surface);
    color: var(--color-semantic-text);
  }
  .viewer-caption {
    font-size: var(--type-scale-step--1);
  }
  .viewer-image img {
    display: block;
    width: 100%;
    height: auto;
  }
  .project-gallery {
    min-width: 0;
  }
  .project-gallery--grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .project-gallery--stack {
    display: grid;
    gap: var(--space-5);
  }
  .project-gallery--grid .project-visual__preview {
    aspect-ratio: 16 / 9;
    background: #fff;
  }
  .project-visual__preview.report img {
    height: auto;
  }
  .project-gallery--grid .project-visual__preview.factory {
    aspect-ratio: 707 / 485;
    background: #101318;
  }
  .project-visual__preview.diagram {
    aspect-ratio: auto;
    background: transparent;
    border: 0;
    border-radius: 0;
  }
  .project-visual__preview.diagram img {
    height: auto;
  }
  figcaption .diagram-hint {
    display: none;
  }
  .caption-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
  }
  .caption-row strong {
    color: var(--color-semantic-text);
    font-weight: 600;
  }
  .caption-row a {
    white-space: nowrap;
    font-size: 12px;
  }
  figcaption small {
    display: block;
    margin-top: 3px;
    font-size: 12px;
  }
  .project-gallery--stack {
    gap: 20px;
  }
  a:focus-visible {
    outline: 3px solid var(--color-semantic-accent);
    outline-offset: 4px;
  }
  @media (max-width: 600px) {
    figcaption .diagram-hint {
      display: block;
    }
    .project-gallery--grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .project-visual__preview.diagram {
      overflow-x: auto;
    }
    .project-visual__preview.diagram img {
      min-width: 700px;
    }
    .viewer-image:has(img[src$=".svg"]) {
      overflow-x: auto;
    }
    .viewer-image img[src$=".svg"] {
      min-width: 900px;
    }
  }
</style>
