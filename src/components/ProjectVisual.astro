---
interface Props {
  slug: string;
  name: string;
}
const { slug, name } = Astro.props;
const visuals: Record<
  string,
  {
    file: string;
    caption: string;
    alt: string;
    width: number;
    height: number;
    kind?: string;
  }
> = {
  Alpha4Gate: {
    file: "alpha4gate-gameplay.jpg",
    caption: "Gameplay alongside the agent's decision graph.",
    alt: "StarCraft II gameplay on the left and a colorful branching decision graph on the right.",
    width: 1080,
    height: 600,
  },
  pta_finance: {
    file: "pta-finance-snapshot.png",
    caption: "A financial snapshot for a treasurer. Fictional example data.",
    alt: "Example treasurer report showing cash balances, fundraising, spending and budget progress.",
    width: 1600,
    height: 900,
  },
  void_furnace: {
    file: "void-furnace-state.png",
    caption:
      "Captured factory state: issues move through implementation, review and merge.",
    alt: "Factory interface showing issue states and transitions, including review, fixes and merge.",
    width: 707,
    height: 889,
    kind: "factory",
  },
  "dev-observatory": {
    file: "observatory-timeline.png",
    caption:
      "Historical execution observations. Expand for the full dashboard, including its separate planning views.",
    alt: "Observed timeline section of a saved workspace dashboard, with horizontal bars for recorded processes.",
    width: 1440,
    height: 3819,
    kind: "timeline",
  },
};
const galleries: Record<string, (typeof visuals)[string][]> = {
  pta_finance: [
    {
      ...visuals.pta_finance,
      caption: "1. Current snapshot. Fictional example data.",
    },
    {
      file: "pta-fundraising-summary.png",
      caption: "2. Fundraising summary. Fictional example data.",
      alt: "Fundraising report with progress toward the goal and income by event.",
      width: 816,
      height: 1056,
      kind: "report",
    },
    {
      file: "pta-reimbursement-private.png",
      caption:
        "3. Private detailed reimbursement report. Anonymized demonstration.",
      alt: "Detailed reimbursement review queue with item decisions, payment amounts and outstanding actions.",
      width: 1400,
      height: 1000,
      kind: "report",
    },
    {
      file: "pta-reimbursement-public.png",
      caption: "4. Public reimbursement summary. Anonymized demonstration.",
      alt: "One-page reimbursement summary with payment totals, status chart and board discussion items.",
      width: 816,
      height: 1056,
      kind: "report",
    },
  ],
  "skill-mesh": [
    {
      file: "skill-mesh-core-pipeline-light.svg",
      caption: "Build pipeline",
      alt: "Skill-mesh build pipeline, from planning and review through building, acceptance and repository updates.",
      width: 1000,
      height: 214,
      kind: "diagram",
    },
    {
      file: "skill-mesh-review-gate-light.svg",
      caption: "Build-step pipeline",
      alt: "One build step: developer agent, automated gates, independent reviewers, verdict and merge, with revision and blocked paths.",
      width: 1080,
      height: 228,
      kind: "diagram",
    },
  ],
  void_furnace: [
    {
      ...visuals.void_furnace,
      caption: "Factory state machine",
      kind: "report",
    },
    {
      file: "void-furnace-launcher.png",
      caption: "Launcher",
      alt: "Operator launcher with command categories and controls for factory operations, diagnostics and iterations.",
      width: 1920,
      height: 1741,
      kind: "report",
    },
  ],
};
const gallery = galleries[slug] ?? (visuals[slug] ? [visuals[slug]] : []);
---

<div
  class:list={[
    "project-gallery",
    {
      "project-gallery--grid": gallery.length > 1 && slug !== "skill-mesh",
      "project-gallery--stack": slug === "skill-mesh",
    },
  ]}
>
  {
    gallery.map((visual) => {
      const src = `${import.meta.env.BASE_URL}projects/${visual.file}`;
      return (
        <figure class="project-visual">
          <a
            class:list={["project-visual__preview", visual.kind]}
            href={src}
            data-image-viewer
            aria-label={`View full ${name}: ${visual.caption}`}
          >
            <img
              src={src}
              alt={visual.alt}
              width={visual.width}
              height={visual.height}
              loading="lazy"
              decoding="async"
            />
            <span class="project-visual__expand">
              View full {visual.kind === "diagram" ? "graphic" : "screenshot"}
            </span>
          </a>
          <figcaption>{visual.caption}</figcaption>
          <dialog aria-label={`${name}: ${visual.caption}`}>
            <div class="viewer-toolbar">
              <a href={src} target="_blank" rel="noopener noreferrer">
                Open original
              </a>
              <button type="button" data-close-viewer>
                Close
              </button>
            </div>
            <p class="viewer-caption">{visual.caption}</p>
            <div class="viewer-image">
              <img
                src={src}
                alt={visual.alt}
                width={visual.width}
                height={visual.height}
                loading="lazy"
              />
            </div>
          </dialog>
        </figure>
      );
    })
  }
</div>

<script>
  document
    .querySelectorAll<HTMLAnchorElement>("[data-image-viewer]")
    .forEach((link) => {
      const dialog = link.closest("figure")?.querySelector("dialog");
      if (!dialog) return;
      link.addEventListener("click", (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
          return;
        event.preventDefault();
        dialog.showModal();
      });
      dialog
        .querySelector("[data-close-viewer]")
        ?.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
</script>

<style>
  figure {
    margin: 0;
    min-width: 0;
  }
  .project-visual__preview {
    display: block;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-semantic-border);
    border-radius: var(--radius-lg);
    background: #101318;
    aspect-ratio: 16 / 9;
  }
  .project-visual__preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .project-visual__preview.factory {
    aspect-ratio: 707 / 485;
  }
  .project-visual__preview.factory img {
    height: auto;
  }
  .project-visual__preview.timeline {
    aspect-ratio: 16 / 6.2;
  }
  .project-visual__preview.timeline img {
    height: auto;
    transform: translateY(-63%);
  }
  .project-visual__expand {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 7px 12px;
    border-radius: 6px;
    background: #101318;
    color: #fff;
    font-size: 12px;
  }
  figcaption {
    margin-top: var(--space-3);
    color: var(--color-semantic-text-muted);
    font-size: var(--type-scale-step--1);
    line-height: var(--type-line-height-base);
  }
  dialog {
    padding: var(--space-4);
    width: min(94vw, 1440px);
    max-width: 96vw;
    max-height: 92vh;
    border: 1px solid var(--color-semantic-border);
    border-radius: var(--radius-lg);
    background: var(--color-semantic-surface);
    color: var(--color-semantic-text);
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 75%);
  }
  .viewer-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }
  .viewer-toolbar a,
  figcaption a {
    color: var(--color-semantic-accent);
  }
  .viewer-toolbar button {
    font: inherit;
    padding: 8px 16px;
    cursor: pointer;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-semantic-border);
    background: var(--color-semantic-surface);
    color: var(--color-semantic-text);
  }
  .viewer-caption {
    font-size: var(--type-scale-step--1);
  }
  .viewer-image img {
    display: block;
    width: 100%;
    height: auto;
  }
  .project-gallery {
    min-width: 0;
  }
  .project-gallery--grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .project-gallery--stack {
    display: grid;
    gap: var(--space-5);
  }
  .project-gallery--grid .project-visual__preview {
    aspect-ratio: 4 / 3;
    background: #eef2f3;
  }
  .project-visual__preview.report img {
    object-fit: contain;
  }
  .project-visual__preview.diagram {
    aspect-ratio: auto;
    background: #fff;
    padding: 12px 12px 42px;
  }
  .project-visual__preview.diagram img {
    height: auto;
  }
  @media (max-width: 540px) {
    .project-gallery--grid {
      gap: var(--space-3);
    }
    .project-gallery--grid .project-visual__expand {
      right: 4px;
      bottom: 4px;
      padding: 4px 6px;
      font-size: 10px;
    }
  }
</style>
