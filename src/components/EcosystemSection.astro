---
// EcosystemSection — the #ecosystem section body: a short narrative explaining how
// the projects in the Work grid fit together as one system, read in three beats —
// the flagships that prove the hard claims, the utilities that keep them honest,
// and the wider range built the same way. Every factual claim traces to the named
// repo's own README/plan — no invented metrics. Projects are referenced by name
// (they carry their own links in the Work grid above), so this section adds no
// external links of its own. Owns its <section> (id + aria-labelledby +
// sticky-header scroll offset); all colors/spacing/type resolve from the brand
// semantic tokens, so it reads intentionally in BOTH light and dark.
import { ANCHORS } from "../consts";

// One beat per entry: a short term + the paragraph that grounds it. Rendered as a
// <dl> so assistive tech announces term → description pairs.
const BEATS = [
  {
    term: "Five flagship projects",
    body: "Alpha4Gate explores self-improving game agents. np-finance turns financial records into reports for a treasurer. skill-mesh provides a reusable planning, building, and review workflow. Void Furnace applies that workflow to autonomous issue-to-PR development. dev-observatory brings project goals, built work, and planned work into a shared view.",
  },
  {
    term: "Verification and visibility",
    body: "The supporting tools make decisions easier to inspect: measure-twice compares model performance, citation-needed verifies quoted evidence against fetched sources, and utilities such as tripwire, paper-trail, and changed-check record decisions and guide validation. These controls help detect errors; they do not guarantee correctness.",
  },
  {
    term: "A wider range of applications",
    body: "The additional projects apply these methods to forecasting, learning, creative work, and everyday tasks. The common thread is an inspectable process: define the task, build it, check the result, and keep the evidence for review.",
  },
];
---

<section
  id={ANCHORS.ecosystem}
  class="ecosystem-section"
  aria-labelledby="ecosystem-heading"
>
  <h2 id="ecosystem-heading">How it all fits together</h2>
  <p class="ecosystem-lede">
    These projects connect practical applications with reusable development
    tools. Planning, independent review, tests, and recorded evidence help me
    evaluate changes before shipping them.
  </p>
  <dl class="ecosystem-beats">
    {
      BEATS.map((beat) => (
        <div class="ecosystem-beat">
          <dt>{beat.term}</dt>
          <dd>{beat.body}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .ecosystem-section {
    max-width: 48rem;
    margin-inline: auto;
    padding: var(--space-8) var(--space-4);
    /* Offset the sticky header so the anchored heading isn't hidden under it. */
    scroll-margin-top: var(--anchor-offset, 7rem);
    border-top: 1px solid var(--color-semantic-border);
  }

  .ecosystem-section h2 {
    margin: 0 0 var(--space-4);
    color: var(--color-semantic-text);
    font-family: var(--font-heading);
    font-size: var(--type-scale-step-3);
    font-weight: var(--type-weight-bold);
    line-height: var(--type-line-height-tight);
  }

  .ecosystem-lede {
    margin: 0 0 var(--space-6);
    max-width: 42rem;
    color: var(--color-semantic-text-muted);
    font-size: var(--type-scale-step-0);
    line-height: var(--type-line-height-base);
  }

  .ecosystem-beats {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .ecosystem-beat {
    /* An accent rule on the leading edge ties the three beats together visually
     * without a heavy card treatment; logical padding keeps it correct in RTL. */
    padding-inline-start: var(--space-4);
    border-inline-start: 2px solid var(--color-semantic-accent);
  }

  .ecosystem-beat dt {
    margin: 0 0 var(--space-2);
    color: var(--color-semantic-text);
    font-family: var(--font-heading);
    font-size: var(--type-scale-step-1);
    font-weight: var(--type-weight-semibold);
    line-height: var(--type-line-height-tight);
  }

  .ecosystem-beat dd {
    margin: 0;
    max-width: 42rem;
    color: var(--color-semantic-text);
    font-size: var(--type-scale-step-0);
    line-height: var(--type-line-height-base);
  }
</style>
